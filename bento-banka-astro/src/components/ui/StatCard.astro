---
import type { StatCardProps } from "../../types";
import GlassCard from './GlassCard.astro';

const { value, label, suffix = '' } = Astro.props as StatCardProps;

const id = `stat-${Math.random().toString(36).slice(2)}`;
const countUpScript = `
(function() {
  const el = document.getElementById('${id}');
  if (!el) return;
  const target = ${value};
  const span = el.querySelector('.count');
  let started = false;
  const duration = 2000;
  const io = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting && !started) {
      started = true;
      const start = Date.now();
      const tick = () => {
        const elapsed = Date.now() - start;
        const progress = Math.min(elapsed / duration, 1);
        const v = Math.floor(progress * target);
        if (span) span.textContent = target === 99.9 ? '99.9' : v.toLocaleString();
        if (progress < 1) requestAnimationFrame(tick);
      };
      tick();
    }
  }, { threshold: 0.3 });
  io.observe(el);
})();
`;
---

<div id={id} class="statcard" data-value={value}>
  <GlassCard class="p-4 text-center">
    <div class="text-xl font-bold text-foreground">
      <span class="count">0</span>{suffix}
    </div>
    <p class="text-xs text-muted-foreground mt-1">{label}</p>
  </GlassCard>
</div>

<script type="module" set:html={countUpScript} />

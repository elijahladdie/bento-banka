---
import type { PricingToggleProps } from "../../types";
const { interval = 'year' } = Astro.props as PricingToggleProps;
---

<div class="flex items-center gap-3 mx-auto my-auto">
  <span class={interval !== 'year' ? 'text-white font-medium' : 'text-white/50'}>Monthly</span>
  <label class="relative inline-flex items-center cursor-pointer">
    <input type="checkbox" class="sr-only peer" checked={interval === 'year'} />
    <div class="h-7 w-12 rounded-full bg-white/10 peer-checked:bg-yellow-500"></div>
    <div class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white peer-checked:translate-x-5 transition-transform"></div>
  </label>
  <span class={interval === 'year' ? 'text-white font-medium' : 'text-white/50'}>Yearly</span>
</div>

---
import type { PricingCardProps } from "../../types";
import { formatBillingLabel, formatMoney } from "./format";

const {
  plan,
  locale,
  freeLabel,
  billedLabel,
  billingMonthLabel,
  billingYearLabel,
  popularLabel,
  trialLabel,
  ctaLabel,
} = Astro.props as PricingCardProps;

const formattedPrice = formatMoney(locale, plan.priceAmount, plan.currencyCode, freeLabel);
const billingLabel = formatBillingLabel(plan, billedLabel, billingMonthLabel, billingYearLabel);
const visibleFeatures = plan.features.slice(0, 4);

---

<div class={"glass-card pricing-card" + (plan.popular ? " is-popular" : "")}>
  <div class="flex h-full flex-col">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-xl font-semibold text-[var(--text-primary)]">{plan.name}</h3>
        <p class="mt-2 whitespace-pre-line text-sm leading-6 text-[var(--text-secondary)]">{plan.description}</p>
      </div>

      {plan.popular ? (
        <span class="inline-flex shrink-0 rounded-full border border-[rgba(110,180,80,0.55)] bg-[rgba(110,180,80,0.18)] px-3 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-[rgba(110,180,80,0.9)]">
          {popularLabel}
        </span>
      ) : null}
    </div>

    <div class="mt-8 flex items-end gap-3">
      <span class="text-4xl font-semibold tracking-tight text-[var(--text-primary)]">{formattedPrice} /</span>
      <span class="pb-1 text-sm text-[var(--text-secondary)]">{billingLabel}</span>
    </div>

    {plan.trialLabel ? (
      <div class="mt-2 flex min-h-[28px] flex-wrap items-center gap-2">
        <>
          <span class="inline-flex rounded-full border border-[rgba(96,165,250,0.35)] bg-[rgba(59,130,246,0.12)] px-3 py-1 text-xs font-medium text-[var(--info-primary)]">{plan.trialLabel}</span>
          <span class="text-xs text-[var(--text-muted)]">{trialLabel}</span>
        </>
      </div>
    ) : null}

    <p class="text-sm py-2 mt-2 text-[var(--text-muted)] text-bold">What's included</p>

    {plan.features.length ? (
      <div class='hover-root mt-0 w-full rounded-2xl text-left'>
        <button
          type="button"
          class="hover-trigger w-full text-left"
          aria-label={`${plan.name} features`}
        >
          <div class="space-y-3 text-sm leading-6 text-[var(--text-secondary)]">
            {visibleFeatures.map((feature) => (
              <div key={feature} class="flex items-start gap-3">
                <svg class={`mt-1 h-4 w-4 shrink-0 ${plan.popular ? "text-[rgb(20,20,20)]" : "text-[var(--gold)]"}`} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden>
                  <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>

                <span>{feature}</span>
              </div>
            ))}
          </div>

          {plan.features.length > visibleFeatures.length ? (
            <p class="mt-3 text-xs font-medium uppercase tracking-[0.18em] text-[var(--text-muted)]">Hover to see all features</p>
          ) : null}
        </button>

        <div class={`hover-card ${plan.popular ? 'popular' : 'default'}`} role="dialog" aria-hidden>
          <div class="space-y-4">
            <p class="text-sm leading-7 text-[var(--text-secondary)]">{plan.featureInfo}</p>

            {plan.features.length ? (
              <ul class="space-y-2 text-sm leading-6 text-[var(--text-primary)]">
                {plan.features.map((feature) => (
                  <li key={feature} class="flex gap-3">
                    <span class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full ${plan.popular ? 'bg-[rgb(110,180,80)]' : 'bg-[var(--gold)]'}`}></span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        </div>
      </div>
    ) : null}

    <div class="mt-8">
      <button type="button" class={`btn ${plan.popular ? 'btn-secondary' : 'btn-primary'} w-full rounded-full px-5 py-3 text-sm font-semibold`} aria-label={`${ctaLabel} ${plan.name}`}>
        {ctaLabel}
      </button>
    </div>
  </div>
</div>

<style>
.hover-root{position:relative}
.hover-trigger{background:transparent;border:0;padding:0}
.hover-card{position:absolute;left:0;top:100%;margin-top:0.5rem;z-index:50;display:none;max-width:22rem;border-radius:1rem;padding:1.25rem}
.hover-root:hover .hover-card,.hover-root:focus-within .hover-card{display:block}
.hover-card.default{border:1px solid rgba(255,255,255,0.18);background:rgba(10,15,30,0.96);box-shadow:0 24px 80px rgba(0,0,0,0.45)}
.hover-card.popular{border:1px solid rgba(110,180,80,0.35);background:rgba(110,180,80,0.12);box-shadow:0 24px 80px rgba(110,180,80,0.2)}
.glass-card{padding:1.25rem;border-radius:1.25rem}
.btn-primary{background:var(--gold);color:var(--text-dark)}
.btn-secondary{background:rgba(110,180,80,0.9);color:var(--text-dark)}
</style>
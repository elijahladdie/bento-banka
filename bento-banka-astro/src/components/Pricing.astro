---
import GlassCard from "./ui/GlassCard.astro";
import PricingCard from "./pricing/PricingCard.astro";
import PricingSkeleton from "./pricing/PricingSkeleton.astro";
import PricingToggle from "./pricing/PricingToggle.astro";
import { Icon } from "@lucide/astro";
import { transformPricingResponse } from "../utils/format";
import type { PricingInterval, PricingPlan } from "./pricing/types";
import { createTranslator } from "../utils/ui";

const { locale = "en" } = Astro.props;
const t = createTranslator(locale);

const url = new URL(Astro.request.url);
const interval: PricingInterval =
  url.searchParams.get("interval") === "month" ? "month" : "year";

let plans: PricingPlan[] = [];
let error: string | null = null;

try {
  const response = await fetch(
    `${Astro.url.origin}/api/pricing?interval=${interval}`,
  );

  if (!response.ok) {
    throw new Error(`Pricing request failed with status ${response.status}`);
  }

  const payload = await response.json();

  plans = transformPricingResponse(payload, interval);
} catch (err) {
  error = err instanceof Error ? err.message : t("landing.pricing.errorBody");
}

const currentLoadingLabel = `${t("landing.pricing.loadingTitle")}: ${
  interval === "month"
    ? t("landing.pricing.monthly")
    : t("landing.pricing.yearly")
}`;
---

<section id="pricing" class="relative overflow-hidden px-4 py-20 sm:py-24">
  <div class="container mx-auto relative z-10">
    <div class="mx-auto mb-5 max-w-3xl text-center sm:mb-14">
      <p
        class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--text-gold)]"
      >
        {t("landing.pricing.kicker", "Pricing")}
      </p>
      <h2
        class="mt-3 text-3xl font-semibold text-[var(--text-primary)] sm:text-4xl lg:text-5xl"
      >
        {t("landing.pricing.title")}
      </h2>
      <p
        class="mt-4 text-sm leading-7 text-[var(--text-secondary)] sm:text-base"
      >
        {t("landing.pricing.subtitle")}
      </p>
    </div>

    <PricingToggle interval={interval} />

    <div class="mx-auto w-full relative mt-10">
      <div class="pricing-grid">
        {
          error ? (
            <GlassCard padding="lg" class="mx-auto max-w-2xl text-center">
              <div class="flex flex-col items-center gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[rgba(248,113,113,0.35)] bg-[rgba(248,113,113,0.12)] text-[var(--error-text)]">
                  <Icon name="lucide:alert-triangle" class="h-6 w-6" />
                </div>

                <div>
                  <h3 class="text-2xl font-semibold text-[var(--text-primary)]">
                    {t("landing.pricing.errorTitle")}
                  </h3>

                  <p class="mt-2 text-sm leading-7 text-[var(--text-secondary)]">
                    {t("landing.pricing.errorBody")}
                  </p>

                  <p class="mt-3 text-xs text-[var(--text-muted)]">
                    {error}
                  </p>
                </div>

                <button
                  type="button"
                  onclick="window.location.reload()"
                  class="btn-primary glass-surface-lift inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold"
                  aria-label={t("landing.pricing.retry")}
                >
                  <Icon name="lucide:refresh-ccw" class="h-4 w-4" />
                  {t("landing.pricing.retry")}
                </button>
              </div>
            </GlassCard>
          ) : plans.length === 0 ? (
            <>
              <div class="space-y-4">
                <div class="flex items-center gap-3 text-sm text-[var(--text-secondary)]">
                  <Icon
                    name="lucide:refresh-ccw"
                    class="h-4 w-4 animate-spin"
                  />
                  <span>{currentLoadingLabel}</span>
                </div>

                <p class="text-sm text-[var(--text-secondary)]">
                  {t("landing.pricing.loadingBody")}
                </p>

                <PricingSkeleton />
              </div>

              <PricingSkeleton />
            </>
          ) : (
            plans.map((plan) => (
              <PricingCard
                plan={plan}
                locale={locale}
                freeLabel={t("landing.pricing.free")}
                billingMonthLabel={t("landing.pricing.billingMonth")}
                billingYearLabel={t("landing.pricing.billingYear")}
                popularLabel={t("landing.pricing.popular")}
                trialLabel={t("landing.pricing.trial")}
                ctaLabel={t("landing.pricing.cta")}
              />
            ))
          )
        }
      </div>
    </div>
  </div>
</section>
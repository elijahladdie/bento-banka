---
import { Landmark } from "@lucide/astro";
import GlassButton from "./ui/GlassButton.astro";

const { t, languages, currentLocale } = Astro.props;

const localeScript = `
(function() {
  const select = document.getElementById("language-switcher");
  select?.addEventListener("change", (e) => {
    const locale = e.target.value;
    document.cookie = \`locale=\${locale}; path=/; max-age=31536000\`;
    window.__LOCALE__ = locale;
    window.dispatchEvent(
      new CustomEvent("locale-change", {
        detail: { locale },
      }),
    );
  });
})();
`;
---

<nav
  class="fixed left-0 right-0 top-0 z-50 border-b border-[var(--glass-border)] bg-[rgba(10,15,30,0.55)] backdrop-blur-2xl"
>
  <div class="container mx-auto flex items-center justify-between h-16 px-4">
    <div class="flex items-center gap-2">
      <Landmark class="h-7 w-7 text-primary" />
      <span class="text-xl font-bold text-foreground">BANKA</span>
    </div>

    <div class="flex items-center gap-3">
      <GlassButton variant="secondary">
        {t("landing.signIn", "Sign In")}
      </GlassButton>

      <GlassButton>
        {t("landing.openAccount", "Open an Account")}
      </GlassButton>

      <div class="relative">
        <select
          id="language-switcher"
          class="h-10
      rounded-xl
      border border-white/10
      bg-transparent
      px-4
      pr-10
      text-sm
      text-white
      backdrop-blur-xl
      outline-none
      transition-all
      duration-300
      hover:border-white/20
      focus:border-primary
      focus:ring-2
      focus:ring-primary/30
      appearance-none
      cursor-pointer"
        >
          {
            languages.map((lang) => (
              <option
                value={lang.code}
                selected={currentLocale === lang.code}
                class="bg-[#0f172a] text-white"
              >
                {lang.label}
              </option>
            ))
          }
        </select>

        <!-- Custom Chevron -->
        <div
          class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-white/70"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</nav>

<script type="module" set:html={localeScript} />

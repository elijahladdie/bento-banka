---
export const prerender = false;
import {
  Shield,
  ArrowRightLeft,
  Users,
  FileText,
  Clock,
  Lock,
  ArrowRight,
  Landmark,
} from "@lucide/astro";
import GlassCard from "./ui/GlassCard";
import AmbientBackground from "./ui/AmbientBackground";
import GlassButton from "./ui/GlassButton";
import Footer from "./ui/Footer";
// React island
import StatCard from "./ui/StatCard";
import { createTranslator } from "../utils/ui";

const locale = Astro.locals.locale;
const t = createTranslator(locale);
const features = [
  {
    icon: Users,
    titleKey: "landing.features.multiAccount.title",
    descKey: "landing.features.multiAccount.desc",
  },
  {
    icon: ArrowRightLeft,
    titleKey: "landing.features.transfers.title",
    descKey: "landing.features.transfers.desc",
  },
  {
    icon: Shield,
    titleKey: "landing.features.roles.title",
    descKey: "landing.features.roles.desc",
  },
  {
    icon: FileText,
    titleKey: "landing.features.audit.title",
    descKey: "landing.features.audit.desc",
  },
  {
    icon: Clock,
    titleKey: "landing.features.uptime.title",
    descKey: "landing.features.uptime.desc",
  },
  {
    icon: Lock,
    titleKey: "landing.features.encryption.title",
    descKey: "landing.features.encryption.desc",
  },
];

const stats = [
  {
    value: 10000,
    labelKey: "landing.stats.clients",
    suffix: "+",
  },
  {
    value: 50000,
    labelKey: "landing.stats.transactions",
    suffix: "+",
  },
  {
    value: 99.9,
    labelKey: "landing.stats.uptime",
    suffix: "%",
  },
  {
    value: 3,
    labelKey: "landing.stats.roles",
    suffix: "",
  },
];

const steps = [
  {
    step: 1,
    titleKey: "landing.steps.signUp.title",
    descKey: "landing.steps.signUp.desc",
  },
  {
    step: 2,
    titleKey: "landing.steps.approved.title",
    descKey: "landing.steps.approved.desc",
  },
  {
    step: 3,
    titleKey: "landing.steps.accounts.title",
    descKey: "landing.steps.accounts.desc",
  },
  {
    step: 4,
    titleKey: "landing.steps.transact.title",
    descKey: "landing.steps.transact.desc",
  },
];
const currentLocale = Astro.locals.locale || "en";
const languages = [
  { code: "en", label: "English" },
  { code: "fr", label: "Français" },
  { code: "kin", label: "Kinyarwanda" },
];
---

<div class="min-h-screen bg-background">
  <AmbientBackground />

  <!-- Nav -->
  <nav
    class="fixed left-0 right-0 top-0 z-50 border-b border-[var(--glass-border)] bg-[rgba(10,15,30,0.55)] backdrop-blur-2xl"
  >
    <div class="container mx-auto flex items-center justify-between h-16 px-4">
      <div class="flex items-center gap-2">
        <Landmark class="h-7 w-7 text-primary" />
        <span class="text-xl font-bold text-foreground">BANKA</span>
      </div>

      <div class="flex items-center gap-3">
        <GlassButton variant="secondary">
          {t("landing.signIn", "Sign In")}
        </GlassButton>

        <GlassButton>
          {t("landing.openAccount", "Open an Account")}
        </GlassButton>
        <!-- <select
            id="language-switcher"
            class="h-10 rounded-xl border border-white/10 bg-white/5 px-3 text-sm text-foreground backdrop-blur-md outline-none"
          >
            {
              languages.map((lang) => (
                <option
                  value={lang.code}
                  selected={currentLocale === lang.code}
                >
                  {lang.label}
                </option>
              ))
            }
          </select>
          <LanguageSwitcher/> -->

        <div class="relative">
          <select
            id="language-switcher"
            class="h-10
      rounded-xl
      border border-white/10
      bg-transparent
      px-4
      pr-10
      text-sm
      text-white
      backdrop-blur-xl
      outline-none
      transition-all
      duration-300
      hover:border-white/20
      focus:border-primary
      focus:ring-2
      focus:ring-primary/30
      appearance-none
      cursor-pointer"
          >
            {
              languages.map((lang) => (
                <option
                  value={lang.code}
                  selected={currentLocale === lang.code}
                  class="bg-[#0f172a] text-white"
                >
                  {lang.label}
                </option>
              ))
            }
          </select>

          <!-- Custom Chevron -->
          <div
            class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-white/70"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pb-10 pt-32">
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-primary/10 animate-orb-float"
      >
      </div>
      <div
        class="absolute left-10 top-40 h-48 w-48 rounded-full bg-primary/5 animate-orb-float"
      >
      </div>
      <div
        class="absolute bottom-10 right-1/3 h-64 w-64 rounded-full bg-primary/8 animate-orb-float"
      >
      </div>
    </div>

    <div class="container mx-auto text-center relative z-10">
      <GlassCard className="mx-auto max-w-3xl py-16 px-8">
        <h1 class="text-5xl md:text-7xl font-black text-foreground mb-2">
          {t("landing.heroTitle", "Bank of Citizens")}
        </h1>

        <div class="w-24 h-1 bg-primary mx-auto mb-6 rounded-full"></div>

        <p class="text-xl text-muted-foreground mb-10 max-w-lg mx-auto">
          {t("landing.heroSubtitle", "Secure. Simple. Yours.")}
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-4"
        >
          <GlassButton
            className="px-8 text-base flex flex-row whitespace-nowrap"
          >
            {t("landing.openAccount", "Open an Account")}
            <ArrowRight class="ml-1 h-5 w-5" />
          </GlassButton>

          <GlassButton variant="secondary" className="px-8 text-base">
            {t("landing.signIn", "Sign In")}
          </GlassButton>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- Features -->
  <section class="py-10 px-4">
    <div class="container mx-auto">
      <h2 class="text-3xl font-bold text-center text-foreground mb-12">
        {t("landing.whyTitle", "Why BANKA?")}
      </h2>

      <div class="bento-grid">
        {
          features.map((f) => {
            const Icon = f.icon;

            return (
              <GlassCard key={f.titleKey} class="group glass-surface-lift">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
                  <Icon class="h-6 w-6 text-primary" />
                </div>

                <h3 class="text-lg font-semibold text-foreground mb-2">
                  {t(f.titleKey)}
                </h3>

                <p class="text-muted-foreground text-sm">{t(f.descKey)}</p>
              </GlassCard>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-20 px-4">
    <div class="container mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-semibold text-foreground">
          {t("landing.statsTitle", "Platform Stats")}
        </h2>

        <p class="text-sm text-muted-foreground mt-2">
          {t("landing.statsSubtitle", "Trusted performance at scale")}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          stats.map((s) => (
            <StatCard
              client:load
              value={s.value}
              label={t(s.labelKey)}
              suffix={s.suffix}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 px-4">
    <div class="container mx-auto">
      <div class="text-center mb-12 max-w-xl mx-auto">
        <h2 class="text-3xl font-bold text-foreground">
          {t("landing.howTitle")}
        </h2>

        <p class="text-sm text-muted-foreground mt-3">
          {
            t(
              "landing.howSubtitle",
              "Start banking in minutes with a simple process",
            )
          }
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          steps.map((s) => (
            <GlassCard
              key={s.step}
              class="p-6 flex flex-col gap-4 hover:scale-[1.02] transition-all duration-300"
            >
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-semibold text-sm">
                  {s.step}
                </div>

                <h3 class="text-base font-semibold text-foreground">
                  {t(s.titleKey)}
                </h3>
              </div>

              <p class="text-sm text-muted-foreground leading-relaxed">
                {t(s.descKey)}
              </p>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>

  <Footer
    client:load
    translations={{
      footerLine: t("landing.footerLine"),
      signIn: t("landing.signIn"),
      openAccount: t("landing.openAccount"),
      copyright: t("landing.copyright"),
    }}
  />

  <script>
    const select = document.getElementById("language-switcher");

    select?.addEventListener("change", (e) => {
      const locale = e.target.value;

      document.cookie = `locale=${locale}; path=/; max-age=31536000`;

      window.location.reload();
    });
  </script>
</div>
